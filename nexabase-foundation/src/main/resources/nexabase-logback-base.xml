<?xml version="1.0" encoding="UTF-8"?>
<!--
  Nexabase 共享 Logback 基础配置。
  各模块在自己的 logback-spring.xml 中通过 <include resource="nexabase-logback-base.xml"/> 引入。

  依赖的属性（由模块 logback-spring.xml 通过 <springProperty> 定义）：
    - APP_NAME  : 应用名称，用于日志文件名（source: spring.application.name）
    - LOG_PATH  : 日志目录，默认 logs

  日志模式中 [%X{traceId:-}] 自动输出 MDC 中的 TraceID，
  实现每条日志与请求链路的上下文关联。
-->
<included>

    <!-- 控制台日志模式：使用 Logback 原生颜色指令，兼容 <included> 引入方式 -->
    <property name="LOG_PATTERN_CONSOLE"
              value="%d{yyMMdd | HH:mm:ss.SSS} %magenta([%thread]) %blue([%X{traceId:-}]) %highlight(%-5level) %cyan(%logger{36}) - %msg%n"/>

    <!-- 文件日志模式：纯文本，不含 ANSI 转义，避免文件乱码 -->
    <property name="LOG_PATTERN_FILE"
              value="%d{yyMMdd | HH:mm:ss.SSS} [%thread] [%X{traceId:-}] %-5level %logger{36} - %msg%n"/>

    <!-- 控制台输出（带颜色） -->
    <appender name="CONSOLE" class="ch.qos.logback.core.ConsoleAppender">
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_PATTERN_CONSOLE}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 滚动文件输出（纯文本，无 ANSI） -->
    <appender name="FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH:-logs}/${APP_NAME:-app}.log</file>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH:-logs}/${APP_NAME:-app}.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>1GB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_PATTERN_FILE}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

    <!-- 错误日志单独文件，便于快速定位异常（纯文本，无 ANSI） -->
    <appender name="ERROR_FILE" class="ch.qos.logback.core.rolling.RollingFileAppender">
        <file>${LOG_PATH:-logs}/${APP_NAME:-app}-error.log</file>
        <filter class="ch.qos.logback.classic.filter.ThresholdFilter">
            <level>ERROR</level>
        </filter>
        <rollingPolicy class="ch.qos.logback.core.rolling.SizeAndTimeBasedRollingPolicy">
            <fileNamePattern>${LOG_PATH:-logs}/${APP_NAME:-app}-error.%d{yyyy-MM-dd}.%i.log.gz</fileNamePattern>
            <maxFileSize>50MB</maxFileSize>
            <maxHistory>30</maxHistory>
            <totalSizeCap>500MB</totalSizeCap>
        </rollingPolicy>
        <encoder class="ch.qos.logback.classic.encoder.PatternLayoutEncoder">
            <pattern>${LOG_PATTERN_FILE}</pattern>
            <charset>UTF-8</charset>
        </encoder>
    </appender>

</included>
