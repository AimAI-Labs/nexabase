<?xml version="1.0" encoding="UTF-8"?>
<project xmlns="http://maven.apache.org/POM/4.0.0"
         xmlns:xsi="http://www.w3.org/2001/XMLSchema-instance"
         xsi:schemaLocation="http://maven.apache.org/POM/4.0.0 http://maven.apache.org/xsd/maven-4.0.0.xsd">
    <parent>
        <artifactId>nexabase-parent</artifactId>
        <groupId>io.github.aimai-labs.nexabase</groupId>
        <version>0.0.1-SNAPSHOT</version>
    </parent>
    <modelVersion>4.0.0</modelVersion>

    <artifactId>nexabase-ai</artifactId>

    <dependencies>
        <!-- Nexabase 公共基础模块：统一响应、异常处理、链路追踪、日志规范 -->
        <dependency>
            <groupId>io.github.aimai-labs.nexabase</groupId>
            <artifactId>nexabase-foundation</artifactId>
            <version>${project.version}</version>
        </dependency>
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter</artifactId>
        </dependency>
        <!-- Web REST 接口 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-web</artifactId>
        </dependency>
        <!-- WebFlux：SSE 流式响应（Flux<ServerSentEvent>）；与 web 共存时强制 servlet 栈 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-webflux</artifactId>
        </dependency>
        <!-- RabbitMQ 消费 document.queue.ai -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-amqp</artifactId>
        </dependency>
        <!-- Feign 内部回调 document 拉正文 + 调 search BM25 -->
        <dependency>
            <groupId>org.springframework.cloud</groupId>
            <artifactId>spring-cloud-starter-openfeign</artifactId>
        </dependency>
        <!-- document-api -->
        <dependency>
            <groupId>io.github.aimai-labs.nexabase</groupId>
            <artifactId>nexabase-document-api</artifactId>
            <version>${project.version}</version>
        </dependency>
        <!-- LangChain4j 核心：AiServices / DocumentSplitter / EmbeddingStore / TokenStream -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j</artifactId>
        </dependency>
        <!-- DashScope 社区集成：Qwen Embedding / Chat / StreamingChat（版本由 langchain4j-community-bom 管理） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-community-dashscope</artifactId>
        </dependency>
        <!-- Qdrant 向量存储（版本由 langchain4j-bom 管理） -->
        <dependency>
            <groupId>dev.langchain4j</groupId>
            <artifactId>langchain4j-qdrant</artifactId>
        </dependency>
        <!-- 测试：JUnit 5 -->
        <dependency>
            <groupId>org.springframework.boot</groupId>
            <artifactId>spring-boot-starter-test</artifactId>
            <scope>test</scope>
        </dependency>
        <dependency>
            <groupId>com.mysql</groupId>
            <artifactId>mysql-connector-j</artifactId>
            <scope>runtime</scope>
        </dependency>
        <!-- Druid 连接池（已换回 HikariCP，保留注释备用）
        <dependency>
            <groupId>com.alibaba</groupId>
            <artifactId>druid-spring-boot-3-starter</artifactId>
        </dependency>
        -->
    </dependencies>

</project>
